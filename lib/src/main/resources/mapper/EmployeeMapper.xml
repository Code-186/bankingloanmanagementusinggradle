<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crimsonlogic.bankingloanmanagementsystem.dao.EmployeeMapper">

    <resultMap id="EmployeeResultMap" type="com.crimsonlogic.bankingloanmanagementsystem.userimplementation.Employee">
        <id property="userId" column="employee_id"/>
        <result property="name" column="name"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="password" column="password"/>
        <result property="dateOfBirth" column="date_of_birth"/>
        <result property="bankName" column="bank_name"/>
        <result property="branchId" column="branch_id"/>
        <result property="status" column="status"/>
        <result property="designation" column="designation"/>
        <result property="salary" column="salary"/>
    </resultMap>

    <select id="findByEmail" resultMap="EmployeeResultMap">
        SELECT * FROM employees WHERE email = #{email}
    </select>

    <select id="findById" resultMap="EmployeeResultMap">
        SELECT * FROM employees WHERE employee_id = #{employeeId}
    </select>

    <select id="findAllEmployees" resultMap="EmployeeResultMap">
        SELECT * FROM employees
    </select>

    <select id="findEmployeesByBranch" resultMap="EmployeeResultMap">
        SELECT * FROM employees WHERE branch_id = #{branchId}
    </select>

    <insert id="insertEmployee">
        INSERT INTO employees (employee_id, name, phone_number, email, address, password, date_of_birth, bank_name, status, designation, salary, branch_id)
        VALUES (#{userId}, #{name}, #{phoneNumber}, #{email}, #{address}, #{password}, #{dateOfBirth}, #{bankName}, #{status}, #{designation}, #{salary}, #{branchId})
    </insert>

    <update id="updateEmployeeStatus">
        UPDATE employees SET status = #{status} WHERE employee_id = #{employeeId}
    </update>
</mapper>