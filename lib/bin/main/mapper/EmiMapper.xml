<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crimsonlogic.bankingloanmanagementsystem.dao.EmiMapper">

    <resultMap id="EmiResultMap" type="com.crimsonlogic.bankingloanmanagementsystem.model.EMI">
        <id property="emiId" column="emi_id"/>
        <result property="loanId" column="loan_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="emiAmount" column="emi_amount"/>
        <result property="dueDate" column="due_date"/>
        <result property="status" column="status"/>
    </resultMap>

    <insert id="insertEmi">
        INSERT INTO emis (emi_id, loan_id, customer_id, emi_amount, due_date, status)
        VALUES (#{emiId}, #{loanId}, #{customerId}, #{emiAmount}, #{dueDate}, #{status})
    </insert>

    <select id="findEmiById" resultMap="EmiResultMap">
        SELECT * FROM emis WHERE emi_id = #{emiId}
    </select>

    <select id="findEmisByLoanId" resultMap="EmiResultMap">
        SELECT * FROM emis WHERE loan_id = #{loanId}
    </select>

    <select id="findEmisByCustomerId" resultMap="EmiResultMap">
        SELECT * FROM emis WHERE customer_id = #{customerId}
    </select>

    <update id="updateEmiStatus">
        UPDATE emis SET status = #{status} WHERE emi_id = #{emiId}
    </update>
</mapper>